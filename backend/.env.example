# Serveur
PORT=5000
NODE_ENV=development

# Base de données MongoDB (Atlas ou local)
MONGO_URI=mongodb://127.0.0.1:27017/matchhub

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# CORS - URL du frontend
CLIENT_URL=http://localhost:5173

# Upload
MAX_FILE_SIZE_MB=5

# OAuth Google — créer une app sur https://console.cloud.google.com/apis/credentials
# Authorized redirect URI à déclarer : GOOGLE_CALLBACK_URL ci-dessous
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# OAuth LinkedIn — créer une app sur https://www.linkedin.com/developers/apps
# puis activer le produit "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback
